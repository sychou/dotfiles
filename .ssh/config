# Machine-specific overrides first: ssh_config takes the FIRST value it finds
# for each keyword, so anything in config.local wins over the shared rules
# below. Untracked and optional, same contract as ~/.zshenv.local. Needed
# where a host must use a different key or user than the shared defaults --
# e.g. tiptree pulls dotfiles with a repo deploy key, not the 1Password agent.
Include ~/.ssh/config.local

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github.pub
    IdentitiesOnly yes

# Sheldon's box: the account there is `sheldon`, not `sean`. Without this,
# `ssh tiptree` tries the local username and is refused by publickey.
Host tiptree
    User sheldon

Host *
    IdentityAgent ~/.1password/agent.sock
