#!/bin/sh
# Read stdin to the system clipboard.
#
# One command so .tmux.conf and lf's lfrc do not each hardcode pbcopy. Order
# matters: macOS first, then Wayland (Ubuntu's GNOME default), then X11.

if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
else
    echo "copy: no clipboard tool found (want pbcopy, wl-copy, or xclip)" >&2
    exit 1
fi
