#!/bin/bash
# yadm bootstrap — macOS and Ubuntu
#
# Every machine gets the same core CLI toolchain and the same tracked configs.
# Two things vary:
#
#   1. gui       — whether GUI apps are installed. True on macOS; on Linux it
#                  is a per-machine choice: yadm config local.gui true
#   2. hostname  — each machine's one-off role, below. These are deliberately
#                  keyed on hostname rather than a class, because no two of
#                  them are alike enough to share a category.
#
#   verne    macOS    daily driver + dev
#   lem      macOS    daily driver + dev; muesli sync, ollama as tailnet server,
#                     tailnet exit node (the second, alongside wells)
#   tiptree  macOS    Sheldon's box; OpenClaw (installed by hand). Runs
#                     obsidian-headless instead of the desktop app, syncing
#                     the OpenClaw workspace as the "Sheldon" vault.
#   wells    Ubuntu   msgvault server + Gmail sync
#
# Deliberately -u without -e. Bootstrap is best-effort: one package failing
# should not abandon the other forty. But an unset variable is always a typo,
# never a policy, and silently expanding to "" has already cost us installs.
set -u

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

FAILURES=0
MANUAL=()

log() { echo "[BOOTSTRAP] $*"; }
die() { echo "[BOOTSTRAP] ERROR - $*" >&2; exit 1; }
# Non-fatal failure. Counted so the summary cannot claim success after a step
# quietly gave up.
warn() { echo "[BOOTSTRAP] WARN - $*" >&2; FAILURES=$((FAILURES + 1)); }

# Anything bootstrap cannot do unattended — interactive logins, GUI installers,
# App Store apps, machine-specific deploys. Queued here rather than logged in
# passing, because a note 300 lines up the scrollback is a note you never read.
# Everything queued is reprinted as a checklist at the very end of the run.
manual() { MANUAL+=("$*"); }

# ---------------------------------------------------------------------------
# Platform and class
# ---------------------------------------------------------------------------

OS=$(uname -s)
HOST=$(hostname -s)

# Every per-machine branch keys on $HOST, so a wrong answer here silently skips
# all of them. `hostname` returns macOS's HostName, which when unset falls back
# to a reverse-DNS lookup of the current IP — on some networks that is
# dhcp-10-0-1-5 rather than the machine's name. LocalHostName is not used as the
# value (it is the Bonjour name, only coincidentally equal), but disagreeing
# with it is a reliable signal that the network has renamed us.
if [ "$OS" = Darwin ]; then
    _local_name=$(scutil --get LocalHostName 2>/dev/null || echo "")
    if [ -n "$_local_name" ] && [ "$_local_name" != "$HOST" ]; then
        # One warn, then plain logs — the continuation lines are the same single
        # problem and must not each bump the failure count.
        warn "hostname says '$HOST' but LocalHostName says '$_local_name'."
        log  "  The network may have renamed this machine. Per-machine setup keys"
        log  "  on '$HOST' and will be skipped if that is not what you expect."
    fi
fi

# Everything not installed by a package manager lands here.
BIN_DIR="$HOME/.local/bin"

# Which release tag each BIN_DIR tool was installed from. Without this the
# only "is it current?" signal is the binary's own --version, and those
# disagree wildly in format — "Yazi 26.5.6 (aa52643 2026-05-05)" against
# "Version:\t v5.36.1" against a bare "v0.34.1 (4747fb05)". Recording the tag
# we installed sidesteps parsing seven different conventions.
RELEASE_STATE="$HOME/.local/share/yadm-bootstrap/releases"

# GUI apps: always on macOS, opt-in on Linux.
gui=""
case "$OS" in
    Darwin) gui=1 ;;
    Linux)  [ "$(yadm config local.gui 2>/dev/null)" = "true" ] && gui=1 ;;
esac

log "os=$OS host=$HOST gui=${gui:-0}"

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------

macos_prereqs() {
    if ! xcode-select -p &>/dev/null; then
        log "Installing Xcode Command Line Tools"
        xcode-select --install
        # The install runs in a GUI dialog this script cannot see. If it is
        # dismissed, an unbounded wait hangs bootstrap forever — cap it.
        local waited=0
        until xcode-select -p &>/dev/null; do
            [ "$waited" -ge 1200 ] && die "Command Line Tools not installed after 20m — finish the dialog, then re-run"
            sleep 5
            waited=$((waited + 5))
        done
    else
        log "Xcode Command Line Tools already installed"
    fi

    if ! command_exists brew; then
        # NONINTERACTIVE, or the installer stops for a RETURN keypress and a
        # sudo prompt — which defeats running this unattended on a fresh box.
        log "Installing Homebrew"
        NONINTERACTIVE=1 bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    # The installer does not put brew on PATH for the current shell.
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi

    command_exists brew || die "Homebrew installation failed"
    brew update
}

macos_formulae() {
    log "Installing CLI packages"
    brew install \
        bat \
        eza \
        fd \
        ffmpeg \
        flyctl \
        fzf \
        gdu \
        gh \
        git \
        gogcli \
        htop \
        jless \
        jq \
        lazygit \
        lf \
        lua \
        mise \
        mlx \
        mole \
        mosh \
        neovim \
        nerdfetch \
        ntfy \
        ollama \
        opencode \
        openssl \
        poppler \
        ripgrep \
        starship \
        temporal \
        tmux \
        trash \
        tree \
        tree-sitter-cli \
        uv \
        yadm \
        yazi \
        yq
}

macos_fonts() {
    log "Installing fonts"
    brew install --cask \
        font-fira-code-nerd-font \
        font-jetbrains-mono \
        font-jetbrains-mono-nerd-font
}

# One base list, small per-host exclusions. Adding an app means editing one
# array; a machine opts out by name. Keeps the three Macs from drifting into
# three independently-maintained lists.
CASKS=(
    1password 1password-cli bambu-studio boop chatgpt claude cleanshot
    discord docker-desktop ghostty google-chrome granola handbrake-app
    logi-options+ microsoft-teams monitorcontrol obsidian signal slack
    spotify tailscale-app telegram trezor-suite visual-studio-code vlc
    webex whatsapp wispr-flow zoom
)

macos_casks() {
    local exclude=() keep=() c x skip

    case "$HOST" in
        lem)
            exclude=(trezor-suite)
            ;;
        tiptree)
            # Sheldon's box. OpenClaw is the assistant here, so the other AI
            # desktop apps go; no personal comms, media, or hardware utilities.
            # obsidian is excluded in favour of obsidian-headless — this box has
            # no one sitting at it, it just needs to push the vault to Sync.
            exclude=(
                trezor-suite discord signal telegram whatsapp microsoft-teams
                webex zoom claude chatgpt boop granola wispr-flow spotify vlc
                handbrake-app logi-options+ bambu-studio obsidian
            )
            ;;
    esac

    for c in "${CASKS[@]}"; do
        skip=""
        # ${a[@]+"${a[@]}"} rather than plain "${exclude[@]}": macOS ships bash
        # 3.2, where expanding an empty array under `set -u` is an unbound
        # variable error. Hosts with no exclusions (verne) hit exactly that.
        for x in ${exclude[@]+"${exclude[@]}"}; do
            [ "$c" = "$x" ] && { skip=1; break; }
        done
        [ -z "$skip" ] && keep+=("$c")
    done

    log "Installing GUI apps (${#keep[@]} casks for $HOST)"
    brew install --cask "${keep[@]}"

    manual "Install the App Store-only apps: NextDNS, Paprika Recipe Manager 3,
      Pixelmator Pro, Obsidian Web Clipper (Safari extension).
      See README 'Mac App Store Only'."
}

macos_tailscale_cli() {
    # Expose the Tailscale CLI bundled inside Tailscale.app. A wrapper script is
    # required — the binary refuses to run via symlink (bundle identifier check).
    [ -d "/Applications/Tailscale.app" ] || return 0
    log "Installing tailscale CLI wrapper"
    mkdir -p "$HOME/.local/bin"
    printf '#!/bin/sh\nexec "/Applications/Tailscale.app/Contents/MacOS/Tailscale" "$@"\n' \
        > "$HOME/.local/bin/tailscale"
    chmod +x "$HOME/.local/bin/tailscale"
}

# ---------------------------------------------------------------------------
# Ubuntu
# ---------------------------------------------------------------------------

# --- apt ----------------------------------------------------------------

ubuntu_apt() {
    # The Ubuntu archives over plain HTTP are unreachable from some networks —
    # wells' path filters port 80 to Canonical's mirrors specifically (https to
    # the same hosts answers instantly, and other http sites work fine). The
    # installer writes http:// sources, so every fetch from the main archive —
    # including unattended security upgrades — fails silently until switched.
    # The archives serve both schemes; https is the one that works everywhere.
    local sources=/etc/apt/sources.list.d/ubuntu.sources
    if [ -f "$sources" ] && grep -q 'http://' "$sources"; then
        log "Switching the Ubuntu archive sources to https"
        sudo sed -i 's|http://|https://|g' "$sources"
    fi

    log "Installing apt packages"
    sudo apt-get update
    sudo apt-get install -y \
        build-essential ca-certificates curl gnupg wget unzip \
        git htop jq mosh ripgrep tmux tree fzf yadm openssl libssl-dev \
        bat fd-find trash-cli lua5.4 zsh \
        wl-clipboard xclip \
        unattended-upgrades

    # Renamed on Debian/Ubuntu to avoid binary conflicts. .zshrc aliases
    # bat->batcat, fd->fdfind, trash->trash-put behind a Linux guard.
    log "Note: bat=batcat, fd=fdfind, trash=trash-put on Ubuntu"

    # apt's neovim used to lag badly, which is why this reached for the PPA.
    # That is release-dependent now: 26.04 carries 0.11.x, and the PPA has no
    # build for it at all. Probe before adding — a PPA that does not publish
    # for this suite is not a missing package, it is an apt-get update error
    # on every subsequent run.
    if ! command_exists nvim; then
        local codename; codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
        if curl -fsSL -o /dev/null \
             "https://ppa.launchpadcontent.net/neovim-ppa/stable/ubuntu/dists/${codename}/Release"; then
            log "Installing neovim from PPA"
            sudo add-apt-repository -y ppa:neovim-ppa/stable
            sudo apt-get update
        else
            log "The neovim PPA has no build for ${codename}; using the archive"
        fi
        sudo apt-get install -y neovim || warn "neovim failed to install"
    fi

    sudo dpkg-reconfigure -f noninteractive unattended-upgrades
}

# --- 2. vendor apt repos ---------------------------------------------------

_add_repo() {  # name  keyurl  repoline
    local name=$1 keyurl=$2 repoline=$3
    # A separate statement, not tacked onto the line above: bash expands every
    # word of a `local` before running it, so ${name} there is the still-unset
    # outer variable — an unbound-variable death under set -u.
    local key="/etc/apt/keyrings/${name}.gpg"

    # -s, not -f. A key fetch that 404s still leaves a zero-byte file behind,
    # and treating that as "already done" wedges the repo permanently — no
    # amount of re-running bootstrap can repair it.
    [ -s "$key" ] && return 0

    sudo install -m 0755 -d /etc/apt/keyrings
    if ! curl -fsSL "$keyurl" | sudo gpg --dearmor -o "$key" || [ ! -s "$key" ]; then
        sudo rm -f "$key"
        warn "could not fetch the signing key for $name; skipping that repo"
        return 1
    fi
    sudo chmod a+r "$key"

    # Only after a good key. Writing the .list regardless would leave apt
    # pointed at a repo it cannot verify.
    echo "$repoline" | sudo tee "/etc/apt/sources.list.d/${name}.list" >/dev/null
}

ubuntu_repos() {
    log "Adding vendor apt repositories"

    # The repo line below needs an explicit arch. Left empty, apt rejects the
    # whole .list file, which then poisons every later `apt-get update` —
    # including Docker's.
    local DEB_ARCH; DEB_ARCH=$(dpkg --print-architecture)

    # Only GitHub's own repo lives here now. eza used to come from
    # deb.gierens.de and ntfy from archive.heckel.io; both moved to
    # ubuntu_releases — see the note there.
    _add_repo githubcli \
        "https://cli.github.com/packages/githubcli-archive-keyring.gpg" \
        "deb [arch=${DEB_ARCH} signed-by=/etc/apt/keyrings/githubcli.gpg] https://cli.github.com/packages stable main"

    sudo apt-get update
    sudo apt-get install -y gh || warn "gh failed to install"
}

# --- 3. install scripts ----------------------------------------------------

ubuntu_scripts() {
    command_exists mise     || { log "Installing mise";     curl -fsSL https://mise.run | sh; }
    command_exists uv       || { log "Installing uv";       curl -LsSf https://astral.sh/uv/install.sh | sh; }
    command_exists starship || { log "Installing starship"; curl -sS https://starship.rs/install.sh | sh -s -- -y; }
    command_exists opencode || { log "Installing opencode"; curl -fsSL https://opencode.ai/install | bash; }

    # ollama on every machine. The Linux installer registers a systemd unit at
    # /etc/systemd/system/ollama.service, so it survives reboot without any
    # extra work; macOS gets the equivalent from brew services in
    # common_ollama, which also pulls the shared cloud models on both OSes.
    #
    # Models are NOT pulled here; those stay machine-specific:
    #   ollama pull nomic-embed-text
    #
    # GPU is opt-in and separate: NVIDIA needs CUDA drivers installed
    # (verify with nvidia-smi), AMD needs the extra ROCm package
    # (ollama-linux-amd64-rocm.tar.zst). Without either it runs CPU-only.
    command_exists ollama || { log "Installing ollama"; curl -fsSL https://ollama.com/install.sh | sh; }

    # nerdfetch is a single POSIX shell script, not a package
    if [ ! -x "$BIN_DIR/nerdfetch" ]; then
        log "Installing nerdfetch"
        mkdir -p "$BIN_DIR"
        curl -fsSL -o "$BIN_DIR/nerdfetch" \
            https://raw.githubusercontent.com/ThatOneCalculator/NerdFetch/main/nerdfetch
        chmod +x "$BIN_DIR/nerdfetch"
    fi
}

# --- 4. GitHub releases ----------------------------------------------------
#
# Resolve the latest release asset through the public API rather than `gh`.
# `gh release download` needs an authenticated gh, which a fresh box does not
# have yet — and bootstrap should not require an interactive login. The public
# API allows 60 requests/hour unauthenticated; this makes six.

_release_tag_installed() {  # binary -> prints recorded tag, if any
    [ -f "$RELEASE_STATE" ] || return 0
    awk -v b="$1" '$1 == b { print $2; exit }' "$RELEASE_STATE"
}

_release_tag_record() {  # binary  tag
    mkdir -p "$(dirname "$RELEASE_STATE")"
    touch "$RELEASE_STATE"
    local tmp; tmp=$(mktemp)
    awk -v b="$1" '$1 != b' "$RELEASE_STATE" > "$tmp"
    printf '%s\t%s\n' "$1" "$2" >> "$tmp"
    sort -o "$tmp" "$tmp" && mv "$tmp" "$RELEASE_STATE"
}

_install_release() {  # binary  repo  asset-regex  [path-inside-archive]
    local bin=$1 repo=$2 re=$3 inner=${4:-$1}

    # One API call, both facts. Asking separately for the tag and the asset
    # URL would double the request count against a 60/hour budget.
    local json
    if ! json=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest"); then
        # Offline, or rate-limited. An already-installed tool is not a failure
        # worth counting — it just does not get upgraded on this run.
        if command_exists "$bin"; then
            log "Could not reach the GitHub API for $repo; keeping the installed $bin"
            return 0
        fi
        warn "could not reach the GitHub API for $repo, and $bin is not installed"
        return 1
    fi

    local tag; tag=$(printf '%s' "$json" | jq -r '.tag_name // empty')
    local url; url=$(printf '%s' "$json" \
        | jq -r --arg re "$re" '.assets[]? | select(.name|test($re)) | .browser_download_url' \
        | head -1)
    [ -z "$url" ] && { warn "no asset matching /$re/ in $repo"; return 1; }

    # Upgrade when the published tag has moved on. A tool installed before this
    # state file existed has no recorded tag, so it reinstalls once and is
    # tracked from then on.
    if command_exists "$bin" && [ -n "$tag" ] && [ "$(_release_tag_installed "$bin")" = "$tag" ]; then
        return 0
    fi

    if command_exists "$bin"; then
        log "Updating $bin to $tag from $repo"
    else
        log "Installing $bin $tag from $repo"
    fi
    mkdir -p "$BIN_DIR"
    local tmp; tmp=$(mktemp -d)
    curl -fsSL -o "$tmp/dl" "$url"

    case "$url" in
        *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp" ;;
        *.zip)          unzip -qo "$tmp/dl" -d "$tmp" ;;
        # bare gzipped binary (tree-sitter ships these) — no archive, no
        # inner path to guess
        *.gz)           gunzip -c "$tmp/dl" > "$tmp/$bin"; chmod +x "$tmp/$bin" ;;
        *)              if install -m755 "$tmp/dl" "$BIN_DIR/$bin"; then
                            _release_tag_record "$bin" "$tag"
                        else
                            warn "could not install $bin to $BIN_DIR/$bin"
                        fi
                        rm -rf "$tmp"; return 0 ;;
    esac

    local found; found=$(find "$tmp" -type f -name "$inner" -perm -u+x | head -1)
    [ -z "$found" ] && found=$(find "$tmp" -type f -name "$inner" | head -1)

    # Two distinct failures, deliberately reported apart. The old
    # `[ -n "$found" ] && install ... || warn "could not find ..."` chain fired
    # the same message when install itself failed, sending you looking for a
    # missing archive path when the real problem was the write.
    if [ -z "$found" ]; then
        warn "could not find '$inner' inside $url"
    elif ! install -m755 "$found" "$BIN_DIR/$bin"; then
        warn "found '$inner' but could not install it to $BIN_DIR/$bin"
    else
        # Only on a confirmed write. Recording the tag after a failed install
        # would make the next run believe $bin is already current.
        _release_tag_record "$bin" "$tag"
    fi
    rm -rf "$tmp"
}

ubuntu_releases() {
    log "Installing tools from GitHub releases"
    # NOTE: asset regexes below assume x86_64/amd64. On arm64 these need
    # adjusting per project — the naming is not consistent across them.
    # tree-sitter-cli is REQUIRED by nvim-treesitter's main branch (which
    # init.lua pins), version 0.26.1+, and upstream says to install it via a
    # package manager rather than npm. apt's is too old, so take the release.
    _install_release tree-sitter tree-sitter/tree-sitter    'tree-sitter-linux-x64\.gz$'

    _install_release yq      mikefarah/yq                    'yq_linux_amd64$'
    _install_release gdu     dundee/gdu                      'gdu_linux_amd64\.tgz$'      gdu_linux_amd64
    _install_release jless   PaulJuliusMartinez/jless        'x86_64-unknown-linux-gnu\.zip$'
    _install_release yazi    sxyazi/yazi                     'yazi-x86_64-unknown-linux-gnu\.zip$'
    _install_release gog     openclaw/gogcli                 'linux_amd64\.tar\.gz$'

    # Both were apt packages until the repos stopped being the better source.
    # ntfy's (archive.heckel.io) is gone outright — pubkey and dists/ both 404
    # as of 2026-08. eza's (deb.gierens.de) still works, but it is a
    # community-maintained repackaging; these tarballs are what eza itself
    # publishes, so this is the more direct source, not a fallback.
    _install_release eza     eza-community/eza               'eza_x86_64-unknown-linux-gnu\.tar\.gz$'
    _install_release ntfy    binwiederhier/ntfy              'linux_amd64\.tar\.gz$'
}

ubuntu_docker() {
    command_exists docker && { log "Docker already installed"; return 0; }

    # Official docker-ce repo. Ubuntu's docker.io lags badly and the snap's
    # confinement causes volume-permission surprises with bind mounts.
    log "Installing Docker from the official repository"
    sudo install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    sudo chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
    sudo apt-get update
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin
    sudo usermod -aG docker "$USER"
    manual "Log out and back in — $USER was added to the docker group, which does
      not apply to the current session."
}

ubuntu_unattended_vendors() {
    # Ubuntu's shipped Allowed-Origins covers ${distro_id} only, so every
    # vendor repo below — tailscale, docker, gh — gets security updates just
    # when someone remembers to run `apt upgrade`. On a box reachable over the
    # tailnet that runs unattended for weeks, that is the wrong default.
    #
    # A drop-in rather than an edit to 50unattended-upgrades: that file is a
    # dpkg conffile, so a package upgrade prompts about local modifications.
    # Origins-Pattern is additive across apt.conf.d, and matching on origin=
    # alone avoids depending on a Suite field that Tailscale does not publish
    # (it sets Codename but no Suite, so the "Origin:Suite" shorthand cannot
    # match it).
    log "Extending unattended-upgrades to the vendor repositories"
    sudo tee /etc/apt/apt.conf.d/51unattended-upgrades-vendors >/dev/null <<'EOF'
// Managed by yadm bootstrap. Vendor repos are not covered by the
// distro-only Allowed-Origins list in 50unattended-upgrades.
Unattended-Upgrade::Origins-Pattern {
    "origin=Docker";
    "origin=Tailscale";
    "origin=gh";
};
EOF

    # Reject a malformed drop-in here rather than discovering it the next time
    # a security update silently does not land.
    if ! apt-config dump >/dev/null 2>&1; then
        sudo rm -f /etc/apt/apt.conf.d/51unattended-upgrades-vendors
        warn "the unattended-upgrades drop-in did not parse; removed it"
    fi
}

ubuntu_gui() {
    # Minimal desktop for local management, not a full workstation. Adds a
    # display stack and its update surface to a machine that is mostly reached
    # over Tailscale SSH — worth it for sitting down at, not much more.
    log "Installing minimal Ubuntu desktop"
    sudo apt-get install -y ubuntu-desktop-minimal

    log "Installing GUI apps available from apt"
    sudo apt-get install -y vlc

    # Everything else ships as a .deb or flatpak rather than living in apt.
    manual "Install the GUI apps that ship as vendor .debs, if this box wants them:
      1Password  https://downloads.1password.com/linux/debian/
      Chrome     https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
      Obsidian   https://obsidian.md/download
      VS Code    https://packages.microsoft.com/repos/code
      Ghostty    https://ghostty.org/download
      See README 'Setting Up an Ubuntu Box'."
}

ubuntu_tailscale() {
    command_exists tailscale && { log "Tailscale already installed"; return 0; }
    log "Installing Tailscale"
    curl -fsSL https://tailscale.com/install.sh | sh

    # wells is one of the tailnet's two exit nodes (lem is the other, but lem
    # is macOS and never reaches this function — its arm handles it), so its
    # join advertises that up front rather than needing a second `tailscale
    # set` later. The forwarding sysctls it depends on are handled in the
    # wells one-off arm.
    local flags="--ssh --advertise-tags=tag:server"
    [ "$HOST" = wells ] && flags="$flags --advertise-exit-node"
    manual "Join the tailnet:  sudo tailscale up $flags
      (tag:server must already exist in the ACL policy. For SSH to work the
      policy also needs an 'ssh' rule whose dst includes tag:server —
      without one, tailscale up warns that nobody can access this device.)"
}

# Exit-node duty needs the kernel forwarding packets for other machines.
# Both families: without the IPv6 sysctl, IPv6-destined traffic from tailnet
# clients dies quietly while IPv4 works — a miserable thing to debug. A
# sysctl.d drop-in rather than a live `sysctl -w`, so it survives reboot.
ubuntu_exit_node_tuning() {
    log "Enabling IP forwarding for exit-node duty"
    sudo tee /etc/sysctl.d/99-tailscale.conf >/dev/null <<'EOF'
# Managed by yadm bootstrap: this machine is a Tailscale exit node.
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
    sudo sysctl -q -p /etc/sysctl.d/99-tailscale.conf \
        || warn "could not apply the forwarding sysctls"

    # UDP GRO forwarding: tailscaled warns about this on `up` and it measurably
    # improves forwarded-UDP (i.e. WireGuard relay) throughput. ethtool settings
    # do not survive reboot, so a oneshot unit reapplies them at boot. The
    # logic lives in a script rather than inline in ExecStart= — systemd does
    # its own $-expansion and backslash handling on that line, which silently
    # mangles shell variables and sed escapes. The NIC is detected at runtime,
    # so a hardware change does not leave the tuning pointed at a dead
    # interface. Best-effort — some drivers mark these features [fixed].
    log "Enabling UDP GRO forwarding for exit-node throughput"
    sudo tee /usr/local/sbin/tailscale-udp-gro >/dev/null <<'EOF'
#!/bin/sh
# Managed by yadm bootstrap: UDP GRO tuning for Tailscale exit-node duty.
# See https://tailscale.com/s/ethtool-config-udp-gro
dev=$(ip -o route get 8.8.8.8 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
[ -n "$dev" ] || exit 0
ethtool -K "$dev" rx-udp-gro-forwarding on rx-gro-list off || true
EOF
    sudo chmod +x /usr/local/sbin/tailscale-udp-gro
    sudo tee /etc/systemd/system/tailscale-udp-gro.service >/dev/null <<'EOF'
# Managed by yadm bootstrap: UDP GRO tuning for Tailscale exit-node duty.
[Unit]
Description=Enable UDP GRO forwarding on the default-route NIC for Tailscale
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tailscale-udp-gro

[Install]
WantedBy=multi-user.target
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable --now tailscale-udp-gro.service \
        || warn "could not enable the UDP GRO tuning service"
}

# ---------------------------------------------------------------------------
# Cross-platform
# ---------------------------------------------------------------------------

# Every machine runs zsh. The tracked shell config — aliases, PATH, mise
# activation, starship, secrets — is all zsh; a box left on bash silently
# gets none of it. wells ran bash for a year and every alias and runtime
# lookup quietly broke there. macOS has shipped zsh as the default since
# Catalina, so this is a no-op on the Macs unless an account was switched.
common_zsh() {
    command_exists zsh || { warn "zsh is not installed; login shell left unchanged"; return 1; }
    local zsh_path; zsh_path=$(command -v zsh)

    local current=""
    if [ "$OS" = Darwin ]; then
        current=$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')
    else
        current=$(getent passwd "$USER" | cut -d: -f7)
    fi
    # Any zsh counts — /bin/zsh, /usr/bin/zsh, a brew one. Re-pointing between
    # them is churn, not correctness.
    case "$current" in */zsh) return 0 ;; esac

    log "Switching login shell to $zsh_path (was ${current:-unknown})"
    # chsh refuses a shell not listed in /etc/shells. The Ubuntu package and
    # macOS both register theirs; this covers an unusual install location.
    grep -qx "$zsh_path" /etc/shells 2>/dev/null \
        || echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    # sudo chsh, not bare chsh: run as the user it prompts for a password,
    # which defeats an unattended bootstrap.
    if sudo chsh -s "$zsh_path" "$USER"; then
        manual "Login shell changed to zsh — log out and back in for it to apply.
      First login sources ~/.zshenv, which hard-fails if ~/.zshenv.local is
      missing or still has REPLACE_ME placeholders — fill it in if prompted."
    else
        warn "could not change the login shell to zsh"
        manual "Switch the login shell to zsh by hand:  chsh -s $zsh_path
      (bootstrap tried 'sudo chsh' and it failed.)"
        return 1
    fi
}

# Runtimes are declared in the tracked .config/mise/config.toml, NOT here.
# `mise use --global` writes to that same file, so listing them here too meant
# bootstrap overwriting a config yadm already manages — two declarations that
# could disagree, with whichever ran last winning. `mise install` reads the
# tracked file and installs exactly what it declares. Add a runtime by editing
# the config; this function needs no changes.
common_mise() {
    command_exists mise || die "mise is missing"

    local cfg="$HOME/.config/mise/config.toml"
    if [ ! -f "$cfg" ]; then
        # Without the config, `mise install` succeeds having installed nothing,
        # and every later step that needs node or python fails far from here.
        warn "$cfg is missing — no runtimes declared, so none will be installed."
        manual "Restore the tracked mise config (yadm checkout .config/mise/config.toml)
      and re-run bootstrap. Nothing that needs node, python, or go will work
      until then."
        return 1
    fi

    log "Installing runtimes declared in $cfg"
    mise install
    # Activate so freshly installed node/npm are on PATH for the rest of this run
    eval "$(mise activate bash)"
    mise reshim
}

common_npm() {
    if command_exists npm; then
        log "Installing qmd (local markdown search) + Claude skill"
        npm install -g @tobilu/qmd
        qmd skill install --global --yes -f
    else
        warn "npm is missing (mise node setup failed?)"
    fi
}

common_uv() {
    if command_exists uv; then
        log "Installing Python tools with uv"
        uv tool install tldr
        uv tool install csvkit
    else
        warn "uv is missing"
    fi
}

common_claude_code() {
    command_exists claude && return 0
    log "Installing Claude Code"
    curl -fsSL https://claude.ai/install.sh | bash
}

# Every machine gets the same cloud models — they run on ollama.com, so a
# pull is metadata-only and costs nothing locally. Local models are the
# opposite: machine-specific by design (what fits lem's GPU has no business
# on wells), so they are never pulled here — see the summary note.
OLLAMA_CLOUD_MODELS="mistral-large-3:675b-cloud gemma4:31b-cloud glm-5.2:cloud"

common_ollama() {
    command_exists ollama || { warn "ollama is missing"; return 1; }

    # The installers only put the binary in place. Linux's registers a systemd
    # unit that starts on its own; on macOS brew services gives it a plist so
    # it survives reboot instead of running as an orphaned process. Guarded,
    # because `brew services start` errors on an already-running service.
    if [ "$OS" = Darwin ]; then
        if ! brew services info ollama --json 2>/dev/null | jq -e '.[0].running' >/dev/null 2>&1; then
            log "Starting ollama via brew services"
            brew services start ollama || warn "could not start the ollama service"
        fi
    fi

    # Best-effort: pulls fail when the account is not signed in yet (or the
    # server has not finished starting), and signin is interactive — so the
    # fallback is a manual step, not a warning.
    local m failed=""
    for m in $OLLAMA_CLOUD_MODELS; do
        ollama pull "$m" >/dev/null 2>&1 || failed="$failed $m"
    done
    if [ -n "$failed" ]; then
        local cmds=""
        for m in $failed; do cmds="$cmds
      ollama pull $m"; done
        manual "Sign in to ollama.com so this box sees the shared cloud models:
      ollama signin$cmds"
    fi
}

# muesli syncs Granola transcripts and is only wanted where that sync runs,
# which is a Mac. wells has no reason to hold a Granola refresh token.
macos_muesli() {
    if ! command_exists rustup; then
        log "Installing Rust via rustup"
        curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y
    fi
    [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

    command_exists cargo || { warn "cargo is missing"; return 1; }
    if [ ! -d "$HOME/repos/muesli" ]; then
        log "Cloning muesli"
        mkdir -p "$HOME/repos"
        git clone https://github.com/sychou/muesli.git "$HOME/repos/muesli"
    fi
    log "Installing muesli"
    cargo install --path "$HOME/repos/muesli"
}

# --- tiptree: the OpenClaw workspace as an Obsidian vault ------------------
#
# Sheldon's OpenClaw workspace is mirrored into Obsidian Sync as the "Sheldon"
# vault, so the agent's working files are readable and reviewable from any
# machine running Obsidian. tiptree gets obsidian-headless rather than the
# desktop cask: nobody sits at this box, it only needs to move files.
#
# `ob login` is interactive (email, password, MFA), so it cannot run here.
# Bootstrap detects the session and instructs instead of prompting, which keeps
# the rest of the run unattended.

OB_VAULT="Sheldon"
OB_WORKSPACE="$HOME/.openclaw/workspace"
OB_LABEL="md.obsidian.headless-sync"
# The mise SHIM, deliberately — not the versioned install path. common_mise
# runs `mise use --global node@latest` on every bootstrap, so
# .../installs/node/<version>/bin/ob moves out from under the LaunchAgent the
# next time node bumps. The shim survives that.
OB_BIN="$HOME/.local/share/mise/shims/ob"

tiptree_obsidian_sync_agent() {
    local plist="$HOME/Library/LaunchAgents/${OB_LABEL}.plist"
    log "Installing the $OB_LABEL LaunchAgent"
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"

    # WorkingDirectory is load-bearing: `ob sync` resolves which vault it is
    # operating on from the directory it starts in.
    cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>             <string>${OB_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${OB_BIN}</string>
        <string>sync</string>
        <string>--continuous</string>
    </array>
    <key>WorkingDirectory</key>  <string>${OB_WORKSPACE}</string>
    <key>RunAtLoad</key>         <true/>
    <key>KeepAlive</key>         <true/>
    <key>StandardOutPath</key>   <string>${HOME}/Library/Logs/${OB_LABEL}.log</string>
    <key>StandardErrorPath</key> <string>${HOME}/Library/Logs/${OB_LABEL}.err</string>
</dict>
</plist>
PLIST

    launchctl bootout "gui/$(id -u)/${OB_LABEL}" 2>/dev/null
    if launchctl bootstrap "gui/$(id -u)" "$plist"; then
        log "  continuous sync running — log: ~/Library/Logs/${OB_LABEL}.log"
    else
        warn "could not load $OB_LABEL; check the log above"
    fi
}

tiptree_obsidian_headless() {
    [ -d "$OB_WORKSPACE" ] || {
        warn "$OB_WORKSPACE not found; install OpenClaw first, then re-run"
        return 1
    }
    command_exists npm || { warn "npm is missing; cannot install obsidian-headless"; return 1; }

    if ! command_exists ob; then
        log "Installing obsidian-headless (requires node >= 22)"
        npm install -g obsidian-headless
        # common_mise already reshimmed, but that was before this install —
        # without a second pass there is no shim for OB_BIN to point at.
        mise reshim
    fi

    # Cheapest authenticated call available; failure means no stored session.
    if ! ob sync-list-remote >/dev/null 2>&1; then
        warn "obsidian-headless is not logged in — vault sync is NOT configured."
        manual "Log in to Obsidian Sync on $HOST, then re-run bootstrap to finish
      linking the '$OB_VAULT' vault:
      ob login
      (interactive: email, password, and 2FA if enabled)"
        return 1
    fi

    if ! ob sync-list-remote 2>/dev/null | grep -q "$OB_VAULT"; then
        log "Creating the remote vault '$OB_VAULT'"
        ob sync-create-remote --name "$OB_VAULT"
    fi

    # A .obsidian directory in the workspace is the marker that sync-setup has
    # already linked this folder; running it again re-prompts for the password.
    if [ ! -d "$OB_WORKSPACE/.obsidian" ]; then
        log "Linking $OB_WORKSPACE to the '$OB_VAULT' vault"
        ob sync-setup --vault "$OB_VAULT" --path "$OB_WORKSPACE"
    fi

    tiptree_obsidian_sync_agent
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "$OS" in
    Darwin)
        macos_prereqs
        macos_formulae
        # After the casks: the wrapper reads the CLI out of Tailscale.app, which
        # does not exist until the tailscale-app cask has been installed. Called
        # any earlier it silently no-ops on exactly the fresh machine that needs
        # it, and only appears to work on re-runs.
        [ -n "$gui" ] && { macos_fonts; macos_casks; }
        macos_tailscale_cli
        ;;
    Linux)
        command_exists apt-get || die "only Debian/Ubuntu is supported on Linux"
        # BEFORE the installers, not after. ubuntu_scripts and ubuntu_releases
        # both install into BIN_DIR and both guard on command_exists; with the
        # export at the end of the branch those guards can never see what a
        # previous run installed, so every re-run re-downloaded all ten tools.
        export PATH="$BIN_DIR:$PATH"
        ubuntu_apt
        ubuntu_repos
        ubuntu_scripts
        ubuntu_releases
        ubuntu_tailscale
        ubuntu_docker
        # After both, so the origins it allows are ones that now exist.
        ubuntu_unattended_vendors
        [ -n "$gui" ] && ubuntu_gui
        ;;
    *)
        die "unsupported OS: $OS"
        ;;
esac

common_zsh
common_mise
common_npm
common_uv
common_claude_code
common_ollama
[ "$OS" = Darwin ] && macos_muesli

# ---------------------------------------------------------------------------
# Machine one-offs
# ---------------------------------------------------------------------------

case "$HOST" in
    verne)
        # Daily driver. Everything it needs is in the common path — the arm
        # exists so the primary machine stops reporting itself as unrecognised.
        log "verne: daily driver — no machine-specific setup needed"
        ;;
    lem)
        # The ollama service itself now starts everywhere via common_ollama.
        # What stays lem-specific is the tailnet-server role: other machines
        # point at lem for the local models only it holds.
        manual "lem: set up the muesli sync LaunchAgent. Not yet written — muesli
      is installed by macos_muesli, but nothing schedules the Granola sync.
      Model it on tiptree_obsidian_sync_agent in this file."
        # lem is the tailnet's second exit node. On macOS the Tailscale app
        # does its own packet forwarding, so none of the sysctl/ethtool tuning
        # wells needs applies here — advertising and admin-console approval
        # are the whole job.
        manual "lem: advertise as an exit node:
      tailscale set --advertise-exit-node
      (or Tailscale menu bar -> Settings -> 'Run exit node'), then approve it
      in the admin console (Machines -> lem -> Edit route settings), or add an
      autoApprovers rule covering it."
        ;;
    tiptree)
        manual "tiptree: install OpenClaw by hand — see README 'Machines'."
        tiptree_obsidian_headless
        ;;
    wells)
        ubuntu_exit_node_tuning
        # Advertising is only half of it — traffic routes nowhere until the
        # node is approved. If the join above already happened without the
        # flag, `tailscale set` adds it without disturbing the session.
        manual "Approve wells as an exit node in the Tailscale admin console
      (Machines -> wells -> Edit route settings), or add an autoApprovers
      rule for tag:server. If wells joined without the flag, first run:
      sudo tailscale set --advertise-exit-node"
        manual "wells: run the msgvault deploy sequence — see README 'Machines'."
        ;;
    *)
        # Not a machine this repo knows about. The OS branch above already ran,
        # so core (and on macOS the full cask list) is installed — only the
        # per-machine extras are skipped.
        #
        # warn, not log: on a known machine this branch means the hostname was
        # resolved wrong, and every per-machine step was skipped. That is the
        # silent failure worth being loud about — a genuinely new box costs one
        # line of noise, which is the right trade.
        warn "No machine-specific setup for '$HOST' (known: verne, lem, tiptree, wells)"
        log "  OS detected as $OS — core toolchain installed via the $OS path"
        [ "$OS" = Darwin ] && log "  macOS: full base cask list installed (no exclusions)"
        [ "$OS" = Linux ]  && log "  Linux: GUI apps skipped unless 'yadm config local.gui true'"
        manual "'$HOST' has no machine-specific setup. If this IS a known box, the
      hostname resolved wrong and its per-machine steps were all skipped —
      check 'hostname -s'. If it is genuinely new, add a case arm for it in
      the 'Machine one-offs' section of ~/.config/yadm/bootstrap."
        ;;
esac

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

# Queued last so they print closest to the prompt, where they will be read.
if [ "$OS" = Darwin ]; then
    manual "Index the notes in qmd:
      qmd collection add ~/Vaults/Main --name obsidian
      qmd collection add ~/.local/share/muesli/transcripts --name granola
      qmd update && qmd embed
      See README 'qmd — Local Note Search'."
fi
manual "Pull any local ollama models this box needs — local models are
      machine-specific by design (cloud models are shared and handled by
      common_ollama):
      ollama pull nomic-embed-text"

echo
if [ "$FAILURES" -gt 0 ]; then
    log "Setup finished with $FAILURES warning(s) — search the log above for 'WARN'."
else
    log "Setup is complete."
fi

if [ "${#MANUAL[@]}" -gt 0 ]; then
    echo
    echo "==========================================================================="
    echo " MANUAL STEPS — ${#MANUAL[@]} item(s) bootstrap could not do for you"
    echo "==========================================================================="
    n=1
    for step in ${MANUAL[@]+"${MANUAL[@]}"}; do
        printf '\n%2d. %s\n' "$n" "$step"
        n=$((n + 1))
    done
    echo
    echo "==========================================================================="
fi
