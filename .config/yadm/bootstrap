#!/bin/bash
# yadm bootstrap script for a new Mac

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

if [[ "$(uname)" != "Darwin" ]]; then
    echo "[BOOTSTRAP] This bootstrap is for macOS only."
    exit 1
fi

echo "[BOOTSTRAP] macOS detected."

# Check for Xcode CLI tools and install if not present
if ! xcode-select -p &> /dev/null; then
    echo "[BOOTSTRAP] Installing Xcode Command Line Tools"
    xcode-select --install
    until xcode-select -p &> /dev/null; do
        sleep 5
    done
else
    echo "[BOOTSTRAP] Xcode Command Line Tools already installed"
fi

# Install Homebrew if needed
if ! command_exists brew; then
    echo "[BOOTSTRAP] Installing Homebrew"
    bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Put brew on PATH for the rest of this script (installer does not do this for
# the current shell). Covers Apple Silicon and Intel prefixes.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command_exists brew; then
    echo "[BOOTSTRAP] Homebrew installation failed."
    exit 1
fi

echo "[BOOTSTRAP] Installing/Updating packages"
brew update

brew install \
    bat \
    eza \
    fd \
    ffmpeg \
    flyctl \
    fzf \
    gdu \
    gh \
    gogcli \
    git \
    htop \
    jless \
    jq \
    lazygit \
    lf \
    lua \
    mise \
    mlx \
    mole \
    mosh \
    nerdfetch \
    neovim \
    ntfy \
    ollama \
    opencode \
    openssl \
    poppler \
    ripgrep \
    starship \
    temporal \
    tmux \
    trash \
    tree \
    tree-sitter-cli \
    uv \
    yadm \
    yazi \
    yq

echo "[BOOTSTRAP] Installing fonts"
brew install --cask \
    font-fira-code-nerd-font \
    font-jetbrains-mono \
    font-jetbrains-mono-nerd-font

echo "[BOOTSTRAP] Installing GUI apps"
brew install --cask \
    1password \
    1password-cli \
    bambu-studio \
    boop \
    chatgpt \
    claude \
    cleanshot \
    cmux \
    discord \
    docker-desktop \
    ghostty \
    google-chrome \
    granola \
    handbrake-app \
    logi-options+ \
    microsoft-teams \
    monitorcontrol \
    obsidian \
    signal \
    slack \
    spotify \
    tailscale-app \
    telegram \
    trezor-suite \
    visual-studio-code \
    vlc \
    webex \
    whatsapp \
    wispr-flow \
    zoom

# Not available via Homebrew — install from the Mac App Store:
#   NextDNS, Paprika Recipe Manager 3, Pixelmator Pro, Obsidian Web Clipper (Safari extension)

# Expose the Tailscale CLI bundled inside Tailscale.app. A wrapper script is
# required — the binary refuses to run via symlink (bundle identifier check).
if [ -d "/Applications/Tailscale.app" ]; then
    echo "[BOOTSTRAP] Installing tailscale CLI wrapper"
    mkdir -p "$HOME/.local/bin"
    printf '#!/bin/sh\nexec "/Applications/Tailscale.app/Contents/MacOS/Tailscale" "$@"\n' > "$HOME/.local/bin/tailscale"
    chmod +x "$HOME/.local/bin/tailscale"
fi

# Set up python and node with mise
if command_exists mise; then
    echo "[BOOTSTRAP] Setting up runtimes with mise"
    mise use --global python@3.12
    mise use --global node@latest
    mise use --global bun@latest
    mise use --global go@latest
    mise use --global pnpm@latest
    # Activate mise so the freshly installed node/npm are on PATH for the rest of this script
    eval "$(mise activate bash)"
    mise reshim
else
    echo "[BOOTSTRAP] ERROR - mise installation failed"
    exit 1
fi

# Install global npm tools (require mise node)
if command_exists npm; then
    echo "[BOOTSTRAP] Installing qmd (local markdown search) + Claude skill"
    npm install -g @tobilu/qmd
    qmd skill install --global --yes -f
else
    echo "[BOOTSTRAP] ERROR - npm is missing (mise node setup failed?)"
fi

# Install Python tools with uv
if command_exists uv; then
    echo "[BOOTSTRAP] Installing Python tools with uv"
    uv tool install tldr
    uv tool install csvkit
else
    echo "[BOOTSTRAP] ERROR - uv is missing"
fi

# Install Rust via rustup (needed to build muesli)
if ! command_exists rustup; then
    echo "[BOOTSTRAP] Installing Rust via rustup"
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Build and install muesli (Granola transcript sync) from Sean's fork
if command_exists cargo; then
    if [ ! -d "$HOME/repos/muesli" ]; then
        echo "[BOOTSTRAP] Cloning muesli"
        mkdir -p "$HOME/repos"
        git clone https://github.com/sychou/muesli.git "$HOME/repos/muesli"
    fi
    echo "[BOOTSTRAP] Installing muesli"
    cargo install --path "$HOME/repos/muesli"
else
    echo "[BOOTSTRAP] ERROR - cargo is missing (rustup setup failed?)"
fi

# Install Claude Code (native installer)
if ! command_exists claude; then
    echo "[BOOTSTRAP] Installing Claude Code"
    curl -fsSL https://claude.ai/install.sh | bash
fi

echo "[BOOTSTRAP] Setup is complete."
echo "[BOOTSTRAP] Remember to index your notes in qmd (see README):"
echo "[BOOTSTRAP]   qmd collection add ~/Vaults/Main --name obsidian"
echo "[BOOTSTRAP]   qmd collection add ~/.local/share/muesli/transcripts --name granola"
echo "[BOOTSTRAP]   qmd update && qmd embed"
