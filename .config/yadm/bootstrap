#!/bin/bash
# yadm bootstrap — macOS and Ubuntu
#
# Core is installed everywhere. Beyond that a machine declares what it is, and
# nothing here branches on which machine it happens to be:
#
#   yadm config local.roles "workstation,server"
#
#   workstation  someone sits at it: GUI apps, fonts, desktop tooling
#   server       it serves something and runs unattended: no desktop apps
#
# Roles are additive. lem is both — a daily driver that also serves ollama to
# the tailnet. Unset defaults to workstation on macOS, server on Linux.
#
# Genuinely per-machine work is DATA, not branches, and yadm already keys files
# on hostname:
#
#   ~/.config/launchd/*.plist          system daemons, installed if present
#   ~/Library/LaunchAgents/*.plist     user agents, materialised by yadm
#   ~/.config/yadm/host-extras         sourced if present; the one-offs that
#                                      are neither core nor a role
#
# Adding a machine means declaring its roles and, if it needs them, adding
# ##hostname.<host> alts. It does not mean editing this file.
#
# Deliberately -u without -e. Bootstrap is best-effort: one package failing
# should not abandon the other forty. But an unset variable is always a typo,
# never a policy, and silently expanding to "" has already cost us installs.
set -u

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

FAILURES=0
MANUAL=()

log() { echo "[BOOTSTRAP] $*"; }
die() { echo "[BOOTSTRAP] ERROR - $*" >&2; exit 1; }
# Non-fatal failure. Counted so the summary cannot claim success after a step
# quietly gave up.
warn() { echo "[BOOTSTRAP] WARN - $*" >&2; FAILURES=$((FAILURES + 1)); }

# Anything bootstrap cannot do unattended — interactive logins, GUI installers,
# App Store apps, machine-specific deploys. Queued here rather than logged in
# passing, because a note 300 lines up the scrollback is a note you never read.
# Everything queued is reprinted as a checklist at the very end of the run.
manual() { MANUAL+=("$*"); }

# ---------------------------------------------------------------------------
# Platform and class
# ---------------------------------------------------------------------------

OS=$(uname -s)
HOST=$(hostname -s)

# yadm selects ##hostname.<host> alts by this name, so a wrong answer here
# silently skips every per-machine file. `hostname` returns macOS's HostName,
# which when unset falls back to a reverse-DNS lookup of the current IP — on
# some networks that is dhcp-10-0-1-5 rather than the machine's name.
# LocalHostName is not used as the value (it is the Bonjour name, only
# coincidentally equal), but disagreeing with it says the network renamed us.
if [ "$OS" = Darwin ]; then
    _local_name=$(scutil --get LocalHostName 2>/dev/null || echo "")
    if [ -n "$_local_name" ] && [ "$_local_name" != "$HOST" ]; then
        # One warn, then plain logs — the continuation lines are the same single
        # problem and must not each bump the failure count.
        warn "hostname says '$HOST' but LocalHostName says '$_local_name'."
        log  "  The network may have renamed this machine; its per-machine files"
        log  "  are keyed on '$HOST' and will be skipped if that is wrong."
    fi
fi

# Everything not installed by a package manager lands here.
BIN_DIR="$HOME/.local/bin"

# What version of each self-installed tool is on this box: a release tag for
# the GitHub-release binaries, a short commit for anything built from a git
# checkout. Without it the only "is it current?" signal is the binary's own
# --version, and those disagree wildly in format — "Yazi 26.5.6 (aa52643
# 2026-05-05)" against "Version:\t v5.36.1" against a bare "v0.34.1
# (4747fb05)". Recording what we installed sidesteps parsing all of them.
VERSION_STATE="$HOME/.local/share/yadm-bootstrap/releases"

# What this machine is. Unset means the common case for its OS, so a new box
# is correct before anyone configures it: a Mac is someone's desk, a Linux box
# is something that serves.
ROLES=$(yadm config local.roles 2>/dev/null || true)
if [ -z "$ROLES" ]; then
    case "$OS" in
        Darwin) ROLES=workstation ;;
        Linux)  ROLES=server ;;
    esac
fi
# Commas or spaces, either way.
ROLES=$(printf '%s' "$ROLES" | tr ',' ' ')

has_role() {
    case " $ROLES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

for _r in $ROLES; do
    case "$_r" in
        workstation|server) ;;
        *) warn "unknown role '$_r' in local.roles — known roles: workstation, server" ;;
    esac
done

log "os=$OS host=$HOST roles=$ROLES"

# ---------------------------------------------------------------------------
# Shared helpers
#
# Used by both OS paths, so they live above the platform sections rather than
# inside either one.
# ---------------------------------------------------------------------------

# bootstrap manages what yadm tracks and nothing else — a plist someone
# installed by hand, and Homebrew's own agents, are not ours to reload.
_yadm_tracked() {  # absolute path -> 0 if yadm tracks it
    ( cd "$HOME" && yadm ls-files --error-unmatch "${1#"$HOME"/}" >/dev/null 2>&1 )
}

LAUNCH_DAEMON_INSTALLER="$HOME/bin/install-launch-daemon.sh"

_version_installed() {  # name -> prints the recorded version, if any
    [ -f "$VERSION_STATE" ] || return 0
    awk -v b="$1" '$1 == b { print $2; exit }' "$VERSION_STATE"
}

_version_record() {  # name  version
    mkdir -p "$(dirname "$VERSION_STATE")"
    touch "$VERSION_STATE"
    local tmp; tmp=$(mktemp)
    # Rewrite without this name, append the new value, sort. Chained so that a
    # failure anywhere discards the temp file and leaves the state as it was —
    # a half-written state file would make the next run draw wrong conclusions
    # about what is installed.
    if awk -v b="$1" '$1 != b' "$VERSION_STATE" > "$tmp" \
       && printf '%s\t%s\n' "$1" "$2" >> "$tmp" \
       && sort -o "$tmp" "$tmp"; then
        mv "$tmp" "$VERSION_STATE"
    else
        rm -f "$tmp"
        warn "could not record the installed version of $1"
    fi
}

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------

macos_prereqs() {
    if ! xcode-select -p &>/dev/null; then
        log "Installing Xcode Command Line Tools"
        xcode-select --install
        # The install runs in a GUI dialog this script cannot see. If it is
        # dismissed, an unbounded wait hangs bootstrap forever — cap it.
        local waited=0
        until xcode-select -p &>/dev/null; do
            [ "$waited" -ge 1200 ] && die "Command Line Tools not installed after 20m — finish the dialog, then re-run"
            sleep 5
            waited=$((waited + 5))
        done
    else
        log "Xcode Command Line Tools already installed"
    fi

    if ! command_exists brew; then
        # NONINTERACTIVE, or the installer stops for a RETURN keypress and a
        # sudo prompt — which defeats running this unattended on a fresh box.
        log "Installing Homebrew"
        NONINTERACTIVE=1 bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    # The installer does not put brew on PATH for the current shell.
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi

    command_exists brew || die "Homebrew installation failed"
    brew update
}

