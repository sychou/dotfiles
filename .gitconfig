[push]
	default = simple
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[user]
	name = Sean Chou
	email = sean@choufam.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHt8RzjaCL40xBTmAs6uLuEcMvansgEeiTjxdgGKDpES
[pull]
	rebase = false

# Platform-specific paths (gh, op-ssh-sign) live here so this file stays
# portable. yadm links the right variant — see .config/git/platform##os.*
[include]
	path = ~/.config/git/platform
