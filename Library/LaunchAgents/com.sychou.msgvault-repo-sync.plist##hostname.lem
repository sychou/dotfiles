<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sychou.msgvault-repo-sync</string>
  <!-- lem: pull the msgvault backup repo from wells.

       wells holds the archive and writes snapshots to its own internal drive;
       lem keeps an offsite copy. The repo is
       content-addressed, so this is genuinely incremental — after the first
       ~91G seed only new packs cross the tailnet, and a night that adds 45,000
       messages moved 4.1G.

       07:00, an hour after wells' nightly snapshot at 06:00, so a run always
       replicates a finished snapshot rather than a half-written one.
       StartCalendarInterval, not StartInterval: this wants a specific hour
       relative to wells' cron, not "every N seconds from whenever it
       loaded".

       rsync && curl: a successful pull pings the lem-backup-pulled check on
       Healthchecks.io (24 h period, 6 h grace, routes to Pushover). A failed
       pull sends no ping and the check goes down. Without the curl, launchd
       exits 0 silently and nobody hears about a stalled mirror — which is
       how the check went down on 2026-09-17 after the ping was lost in the
       2026-08-22 dotfiles refactor.

       The ping URL is a write-only secret, so it lives in the untracked
       ~/.config/healthchecks/lem-backup-pulled.url (same contract as
       ~/.zshenv.local) rather than in this tracked file. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/rsync -a --partial wells:/home/sean/backups/msgvault/ /Users/sean/Backups/msgvault/ &amp;&amp; /usr/bin/curl -fsS -m 10 --retry 3 "$(cat /Users/sean/.config/healthchecks/lem-backup-pulled.url)"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/sean/Library/Logs/com.sychou.msgvault-repo-sync.log</string>
  <key>StandardErrorPath</key><string>/Users/sean/Library/Logs/com.sychou.msgvault-repo-sync.err</string>
</dict>
</plist>
